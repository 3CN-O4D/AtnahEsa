NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
DARAJA_TILL_NUMBER=
NEXT_PUBLIC_DARAJA_TILL_NUMBER=
DARAJA_CALLBACK_URL=
# Tuma (I&M Bank) payments
TUMA_EMAIL=
TUMA_API_KEY=
TUMA_CALLBACK_URL=https://asehanta.com/api/payments/tuma-callback
NEXT_PUBLIC_SITE_URL=https://www.asehanta.com
CRON_SECRET=
ADMIN_EMAILS=asehanta@gmail.com

# Google Sheet mirror (server-side only — never exposed to the browser)
# Apps Script web app URL and the shared key from the sheet's doPost handler.
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_KEY=

# AI chatbot — NVIDIA Nemotron (free fast model) or any OpenAI-compatible provider
# Set AI_PROVIDER=nvidia when using the NVIDIA key below.
NVIDIA_API_KEY=nvapi-...
AI_PROVIDER=nvidia
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional fallback provider:
# TOKENHARBOR_API_KEY=thk_live_...
# AI_BASE_URL=https://tokenharbor.ai/v1
# AI_MODEL=deepseek-v4.1-flash:free

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=asehantavlogs

# Cloudflare R2 (listing photos + videos). Photos are re-encoded to WebP
# variants on upload, so the site never calls the Vercel image optimizer.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=asehanta
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_URL=https://media.asehanta.com
# Optional: same value as R2_PUBLIC_URL, exposed to the browser so the image
# loader can recognise the public host. Defaults to media.asehanta.com.
NEXT_PUBLIC_R2_PUBLIC_URL=

# WhatsApp bridge (Render worker) — used by the admin panel to sync groups
WHATSAPP_WORKER_URL=https://atnahesa.onrender.com
WHATSAPP_BRIDGE_SECRET=
# Optional: Twilio for real urgent calls (worker only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: any provider webhook for urgent calls
URGENT_CALL_WEBHOOK=