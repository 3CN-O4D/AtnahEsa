{
  "crons": [
    {
      "path": "/api/cron/purge-taken-media",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/keep-alive-whatsapp",
      "schedule": "*/14 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.asehanta.com/:path*",
      "has": [{ "type": "host", "value": "asehanta.vercel.app" }],
      "permanent": true
    }
  ]
}
