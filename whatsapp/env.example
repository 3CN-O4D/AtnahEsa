# --- Supabase (service role: worker only, never expose publicly) -------------
SUPABASE_URL=https://ewfyrnxwmqdhlzpcfxxg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- AseHanta brain (the deployed Next.js app) ------------------------------
# Local development: http://localhost:3000
CHAT_API_URL=https://www.asehanta.com

# Must match the WHATSAPP_BRIDGE_SECRET set on the Next.js deployment.
WHATSAPP_BRIDGE_SECRET=replace-me

# --- Pairing ----------------------------------------------------------------
# Optional. Digits only, country code included (e.g. 254712345678).
# If set, the worker prints an 8-character pairing code instead of a QR.
# WHATSAPP_PAIR_NUMBER=254712345678

# Optional. Protects /pair, /pair/new and /qr.png. Defaults to
# WHATSAPP_BRIDGE_SECRET when omitted.
# WHATSAPP_PAIR_TOKEN=replace-me

# Optional prefix so test and production pairings can coexist in one database.
WHATSAPP_SESSION_PREFIX=asehanta

# Admin phone numbers (digits only, comma separated) that get a WhatsApp copy
# of every house request, WiFi booking, mover request and escalation.
# They can also issue bot commands (.pause, .start, ...) from these numbers.
# Leave empty to keep alerts email-only.
ADMIN_WHATSAPP_NUMBERS=

# --- Urgent alerts ----------------------------------------------------------
# Edge TTS voice for urgent admin voice notes. Defaults to en-KE-AsiliaNeural.
# WHATSAPP_TTS_VOICE=en-KE-AsiliaNeural

# Optional. A provider-agnostic POST for real phone calls on urgent items.
# Receives { to: [...digits], message, phone, name, priority }.
# URGENT_CALL_WEBHOOK=https://example.com/urgent-call

# Optional direct Twilio calling. All three must be set to enable it.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1...

# Health-check port used by Render/Fly/Railway.
PORT=8080

# How often the worker checks the outbox for email/OTP/receipt messages to
# deliver over WhatsApp. Defaults shown.
WHATSAPP_OUTBOX_POLL_MS=3000
WHATSAPP_OUTBOX_MAX_ATTEMPTS=3
